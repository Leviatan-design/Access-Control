# PostgreSQL Database Configuration (Development Local)
# Formato: postgresql://usuario:password@host:puerto/nombre_db
# DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/access_pass

# PostgreSQL Database Configuration (Docker)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/access_pass

# JWT Configuration
JWT_SECRET_KEY=change-this-development-secret-before-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Super Admin Configuration
SUPER_ADMIN_EMAIL=dev@flowlogic.com
SUPER_ADMIN_PASSWORD=ChangeThis-FlowLogic-2026!

# Demo Users Configuration (para desarrollo/testing)
DEMO_PASSWORD=Demo-FlowLogic-2026!

# Application Configuration
DATA_DIR=./data
PORT=8080
TESTING=false
